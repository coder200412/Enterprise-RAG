# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=phi3:mini
OLLAMA_EMBED_MODEL=nomic-embed-text

# Provider selection: ollama (local) or oci (OCI Generative AI)
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=
OCI_SERVICE_ENDPOINT=
OCI_AUTH_TYPE=API_KEY
OCI_AUTH_PROFILE=DEFAULT
OCI_AUTH_FILE_LOCATION=
OCI_CHAT_MODEL=meta.llama-3.3-70b-instruct
OCI_EMBEDDING_MODEL=cohere.embed-english-v3.0
CORS_ALLOWED_ORIGINS=http://localhost:8501

# Provider selection: ollama (local) or oci (OCI Generative AI)
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=
OCI_SERVICE_ENDPOINT=
OCI_AUTH_TYPE=API_KEY
OCI_AUTH_PROFILE=DEFAULT
OCI_AUTH_FILE_LOCATION=
OCI_CHAT_MODEL=meta.llama-3.3-70b-instruct
OCI_EMBEDDING_MODEL=cohere.embed-english-v3.0
CORS_ALLOWED_ORIGINS=http://localhost:8501

# Security
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@postgres:5432/enterprise_rag

# Streamlit API mode: mock (demo) or http (real FastAPI backend)
API_MODE=mock
API_BASE_URL=http://localhost:8000
ENV=development
SEED_DEMO_DOCUMENTS=true
POSTGRES_DB=enterprise_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Streamlit API mode: mock (demo) or http (real FastAPI backend)
API_MODE=mock
API_BASE_URL=http://localhost:8000
ENV=development
SEED_DEMO_DOCUMENTS=true
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Storage
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads
